# ── Aula Magna Community Edition — configuration ─────────────────────────────
# Copy this file to ".env" and adjust. Sensible defaults mean you can also just
# run it as-is for a first look.

# Where the single SQLite database file lives. Back up your school by copying
# this one file. (In Docker this is /data/community.db on a mounted volume.)
DATABASE_URL="file:./data/community.db"

# Secret used to sign the login cookie. CHANGE THIS to a long random string so
# sessions can't be forged and survive restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# First-run admin account (only used the very first time, when the DB is empty).
ADMIN_EMAIL="admin@school.edu"
ADMIN_PASSWORD="admin"
ADMIN_NAME="School Admin"

# Your school's display name (shown in the top bar + sign-in). Editable in-app.
SCHOOL_NAME="Your School"
